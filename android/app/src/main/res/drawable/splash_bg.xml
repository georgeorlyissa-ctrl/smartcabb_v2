<?xml version="1.0" encoding="utf-8"?>
<!-- Splash natif SmartCabb.
     Avant : fond blanc + icône Capacitor (écran blanc flashant au démarrage,
     puis 2e écran de chargement web → impression de « plusieurs chargements »).
     Maintenant : fond bleu nuit de la marque + tuile logo centrée, identiques
     au fond de l'écran de chargement web (.sc-boot), donc la transition vers
     la WebView est invisible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D3145" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center" />
    </item>
</layer-list>
